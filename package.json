{
  "name": "memhive",
  "version": "0.1.2",
  "description": "Long-term memory for coding agents. Personal by default, shareable through a team hub.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trickstarcandina/memhive.git"
  },
  "homepage": "https://github.com/trickstarcandina/memhive#readme",
  "bugs": {
    "url": "https://github.com/trickstarcandina/memhive/issues"
  },
  "type": "module",
  "bin": {
    "memhive": "dist/memhive.cjs"
  },
  "files": [
    "dist",
    "plugin",
    "plugin-marketplace",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "pack:check": "node scripts/check-pack.mjs",
    "format": "biome format --write .",
    "lint": "biome ci ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.1",
    "smol-toml": "^1.9.1",
    "sqlite-vec": "^0.1.9",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
