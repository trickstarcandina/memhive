{ "description": "memhub memory hooks", "hooks": {
  "SessionStart": [{ "matcher": "startup|resume|clear|compact", "hooks": [{ "type": "command", "command": "{{NODE_SH}} {{BUNDLE_SH}} hook codex SessionStart", "timeout": 10 }] }],
  "PostCompact": [{ "hooks": [{ "type": "command", "command": "{{NODE_SH}} {{BUNDLE_SH}} hook codex PostCompact", "timeout": 10 }] }],
  "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "{{NODE_SH}} {{BUNDLE_SH}} hook codex UserPromptSubmit", "timeout": 5 }] }],
  "PostToolUse": [{ "matcher": ".*", "hooks": [{ "type": "command", "command": "{{NODE_SH}} {{BUNDLE_SH}} hook codex PostToolUse", "timeout": 5 }] }],
  "Stop": [{ "hooks": [{ "type": "command", "command": "{{NODE_SH}} {{BUNDLE_SH}} hook codex Stop", "timeout": 5 }] }] } }
